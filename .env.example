# Copy this file to .env and edit the values. Never commit .env.
# Port that server.js listens on.
PORT=3000
# Must be production on the server, otherwise the admin cookie has no Secure flag.
NODE_ENV=development
# Folder for the local site.db and uploads/ fallback, resolved from the project root. Only matters
# when TURSO_DATABASE_URL and the R2_* vars below are unset.
DATA_DIR=data
# Remote database (Turso, a hosted libSQL/SQLite service with a free tier). Leave both empty to use
# a local SQLite file under DATA_DIR instead - what local dev and the tests do. Needed on hosts with
# no persistent disk (e.g. Render's free web service), since DATA_DIR would otherwise reset on every
# deploy/restart. See docs/DEPLOY.md.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Uploaded images (Cloudflare R2, an S3-compatible bucket with a free tier). Leave all four empty to
# write uploads under DATA_DIR/uploads instead - what local dev and the tests do. Needed on hosts
# with no persistent disk, for the same reason as TURSO_DATABASE_URL above.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public base URL (a r2.dev URL or a custom domain), no trailing slash.
R2_PUBLIC_URL=
# Full site URL without a trailing slash. Used for canonical, hreflang, og:url and og:image.
SITE_URL=http://localhost:3000
# Signs the admin cookie. Changing it logs out every session. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Admin login name.
ADMIN_USERNAME=admin
# bcrypt hash (cost 12) of the admin passphrase. Generate it with:
# node scripts/hash-password.js '<passphrase of at least 20 characters>'
# Paste the hash without quotes. Node does not expand the $ signs in it.
ADMIN_PASSWORD_HASH=
# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Leave empty to skip analytics entirely: no
# script ever loads, and the cookie bar only offers "รับทราบ" (acknowledge) instead of accept/reject.
GA_MEASUREMENT_ID=
