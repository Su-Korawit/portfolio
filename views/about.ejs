<%
// Every block below is optional: the owner fills in what they want from admin settings and the rest is left
// out. Each one carries the language its text came from, so a block that fell back to the other language says
// so with lang=, the same convention as the foreign card in post-card.ejs.
const social = [
  ['github_url', 'GitHub'],
  ['linkedin_url', 'LinkedIn'],
  ['x_url', 'X'],
  ['instagram_url', 'Instagram']
];
const hasSocial = social.some(([key]) => settings[key]) || settings.email;
const hasIntro = Boolean(aboutImages.length || name.value || aboutBody || facts.items.length);
const hasAside = Boolean(aboutColors.length || quote.value);
const hasLower = Boolean(hasAside || aboutVideo);
const hasContact = Boolean(contact.items.length || hasSocial);
-%>
<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main" class="about">
  <article class="about-card">
    <header class="about-head">
      <h1><%= t.navAbout %></h1>
      <%- include('partials/about-star') %>
    </header>
<% if (hasIntro) { -%>
    <div class="about-row about-row-intro">
<% if (aboutImages.length) { -%>
      <figure class="about-figure">
<% if (aboutImages.length === 1) { -%>
        <img class="about-portrait" src="<%= aboutImages[0] %>" alt="<%= imageAlt.value %>"<% if (imageAlt.value && imageAlt.lang !== lang) { %> lang="<%= imageAlt.lang %>"<% } %> decoding="async">
<% } else { -%>
        <div class="about-slides" data-slides>
<% for (const [index, src] of aboutImages.entries()) { -%>
          <div class="about-slide<% if (index === 0) { %> is-current<% } %>"<% if (index > 0) { %> aria-hidden="true"<% } %>>
            <img class="about-portrait" src="<%= src %>" alt="<%= imageAlt.value %>"<% if (imageAlt.value && imageAlt.lang !== lang) { %> lang="<%= imageAlt.lang %>"<% } %>
                 <% if (index === 0) { %>decoding="async"<% } else { %>loading="lazy" decoding="async"<% } %>>
          </div>
<% } -%>
        </div>
        <div class="about-slide-dots" role="group" aria-label="<%= t.aboutSlidesLabel %>">
<% for (const [index, src] of aboutImages.entries()) { -%>
          <button type="button" data-slide-to="<%= index %>"<% if (index === 0) { %> aria-current="true"<% } %> aria-label="<%= t.aboutSlideNumber.replace('{n}', index + 1) %>"></button>
<% } -%>
        </div>
<% } -%>
      </figure>
<% } -%>
      <div class="about-intro">
<% if (name.value) { -%>
        <p class="about-greeting"><%= t.aboutGreeting %></p>
        <p class="about-name"<% if (name.lang !== lang) { %> lang="<%= name.lang %>"<% } %>><%= name.value %></p>
<% } -%>
<% if (aboutBody) { -%>
        <div class="prose"<% if (aboutLang !== lang) { %> lang="<%= aboutLang %>"<% } %>>
          <%- md.render(aboutBody) %>
        </div>
<% } -%>
<% if (facts.items.length) { -%>
        <div class="about-facts">
          <ul<% if (facts.lang !== lang) { %> lang="<%= facts.lang %>"<% } %>>
<% for (const fact of facts.items) { -%>
            <li><%= fact %></li>
<% } -%>
          </ul>
          <svg class="about-rings" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <circle cx="23" cy="38" r="17"/><circle cx="41" cy="38" r="17"/><circle cx="32" cy="24" r="17"/>
          </svg>
        </div>
<% } -%>
      </div>
    </div>
<% } -%>
<% if (hasLower) { -%>
    <div class="about-row about-row-lower">
<% if (hasAside) { -%>
      <div class="about-aside">
<% if (aboutColors.length) { -%>
        <div class="about-colors">
          <p class="about-pill" id="about-colors-label"><%= t.aboutColorsLabel %></p>
          <ul class="about-swatches" aria-labelledby="about-colors-label">
<% for (const color of aboutColors) { -%>
            <li><span class="about-swatch" style="background: <%= color %>"></span><span class="sr-only"><%= color %></span></li>
<% } -%>
          </ul>
        </div>
<% } -%>
<% if (quote.value) { -%>
        <div class="about-quote-wrap">
          <%- include('partials/about-star') %>
          <figure class="about-quote-block">
            <blockquote class="about-quote"<% if (quote.lang !== lang) { %> lang="<%= quote.lang %>"<% } %>><%= quote.value %></blockquote>
<% if (quoteSource.value) { -%>
            <figcaption class="about-quote-source"<% if (quoteSource.lang !== lang) { %> lang="<%= quoteSource.lang %>"<% } %>><cite><%= quoteSource.value %></cite></figcaption>
<% } -%>
          </figure>
        </div>
<% } -%>
      </div>
<% } -%>
<% if (aboutVideo) { -%>
      <div class="about-video">
<% if (locals.consent === 'granted') { -%>
        <div class="about-video-frame">
          <iframe src="https://www.youtube-nocookie.com/embed/<%= aboutVideo %>" title="<%= t.aboutVideoTitle %>" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
<% } else { -%>
        <div class="about-video-frame about-video-wait" data-embed-src="https://www.youtube-nocookie.com/embed/<%= aboutVideo %>" data-embed-title="<%= t.aboutVideoTitle %>">
          <p><%= t.aboutVideoConsent %> <a href="/<%= lang %>/privacy"><%= t.consentPrivacyLink %></a></p>
          <p><a href="https://www.youtube.com/watch?v=<%= aboutVideo %>" rel="noopener external"><%= t.aboutVideoWatch %></a></p>
        </div>
<% } -%>
        <p class="about-pill"><%= t.aboutVideoTitle %></p>
      </div>
<% } -%>
    </div>
<% } -%>
<% if (hasContact) { -%>
    <footer class="about-contact">
      <h2><%= t.aboutContactLabel %></h2>
      <div class="about-contact-cols">
<% if (contact.items.length) { -%>
        <ul class="about-contact-lines"<% if (contact.lang !== lang) { %> lang="<%= contact.lang %>"<% } %>>
<% for (const line of contact.items) { -%>
          <li><%= line %></li>
<% } -%>
        </ul>
<% } -%>
<% if (hasSocial) { -%>
        <ul class="social-list">
<% for (const [key, label] of social) { -%>
<% if (settings[key]) { -%>
          <li><a href="<%= settings[key] %>"><%= label %></a></li>
<% } -%>
<% } -%>
<% if (settings.email) { -%>
          <li><a href="mailto:<%= settings.email %>"><%= settings.email %></a></li>
<% } -%>
        </ul>
<% } -%>
      </div>
    </footer>
<% } -%>
  </article>
</main>
<% if (aboutImages.length > 1) { -%>
<script src="/js/about.js?v=<%= v %>" defer></script>
<% } -%>
<%- include('partials/footer') %>
