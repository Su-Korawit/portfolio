<%
// Every block below is optional: the owner fills in what they want from admin settings and the rest is left
// out. Each one carries the language its text came from, so a block that fell back to the other language says
// so with lang=, the same convention as the foreign card in post-card.ejs.
const social = [
  ['github_url', 'GitHub'],
  ['linkedin_url', 'LinkedIn'],
  ['x_url', 'X']
];
const hasSocial = social.some(([key]) => settings[key]) || settings.email;
const hasIntro = Boolean(aboutImage || name.value || aboutBody || facts.items.length);
const hasLower = Boolean(aboutColors.length || quote.value || aboutPhoto);
const hasContact = Boolean(contact.items.length || hasSocial);
// The four-pointed star that marks the corners of the layout, and the rings in the facts box. Both are
// decoration with no meaning of their own, so they are hidden from assistive technology.
const star = '<svg class="about-star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 0c.9 8.1 3.9 11.1 12 12-8.1.9-11.1 3.9-12 12-.9-8.1-3.9-11.1-12-12C8.1 11.1 11.1 8.1 12 0Z"/></svg>';
-%>
<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main" class="about">
  <article class="about-card">
    <header class="about-head">
      <h1><%= t.navAbout %></h1>
      <%- star %>
    </header>
<% if (hasIntro) { -%>
    <div class="about-row about-row-intro">
<% if (aboutImage) { -%>
      <figure class="about-figure">
        <img class="about-portrait" src="<%= aboutImage %>" alt="<%= imageAlt.value %>"<% if (imageAlt.value && imageAlt.lang !== lang) { %> lang="<%= imageAlt.lang %>"<% } %> decoding="async">
      </figure>
<% } -%>
      <div class="about-intro">
<% if (name.value) { -%>
        <p class="about-greeting"><%= t.aboutGreeting %></p>
        <p class="about-name"<% if (name.lang !== lang) { %> lang="<%= name.lang %>"<% } %>><%= name.value %></p>
<% } -%>
<% if (aboutBody) { -%>
        <div class="prose"<% if (aboutLang !== lang) { %> lang="<%= aboutLang %>"<% } %>>
          <%- md.render(aboutBody) %>
        </div>
<% } -%>
<% if (facts.items.length) { -%>
        <div class="about-facts">
          <ul<% if (facts.lang !== lang) { %> lang="<%= facts.lang %>"<% } %>>
<% for (const fact of facts.items) { -%>
            <li><%= fact %></li>
<% } -%>
          </ul>
          <svg class="about-rings" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <circle cx="23" cy="38" r="17"/><circle cx="41" cy="38" r="17"/><circle cx="32" cy="24" r="17"/>
          </svg>
        </div>
<% } -%>
      </div>
    </div>
<% } -%>
<% if (hasLower) { -%>
    <div class="about-row about-row-lower">
<% if (aboutColors.length || quote.value) { -%>
      <div class="about-aside">
<% if (aboutColors.length) { -%>
        <div class="about-colors">
          <p class="about-pill" id="about-colors-label"><%= t.aboutColorsLabel %></p>
          <ul class="about-swatches" aria-labelledby="about-colors-label">
<% for (const color of aboutColors) { -%>
            <li><span class="about-swatch" style="background: <%= color %>"></span><span class="sr-only"><%= color %></span></li>
<% } -%>
          </ul>
        </div>
<% } -%>
<% if (quote.value) { -%>
        <div class="about-quote-block">
          <%- star %>
          <blockquote class="about-quote"<% if (quote.lang !== lang) { %> lang="<%= quote.lang %>"<% } %>><%= quote.value %></blockquote>
        </div>
<% } -%>
      </div>
<% } -%>
<% if (aboutPhoto) { -%>
      <figure class="about-photo-figure">
        <img class="about-photo" src="<%= aboutPhoto %>" alt="<%= photoCaption.value %>"<% if (photoCaption.value && photoCaption.lang !== lang) { %> lang="<%= photoCaption.lang %>"<% } %> loading="lazy" decoding="async">
<% if (photoCaption.value) { -%>
        <figcaption class="about-pill"<% if (photoCaption.lang !== lang) { %> lang="<%= photoCaption.lang %>"<% } %>><%= photoCaption.value %></figcaption>
<% } -%>
      </figure>
<% } -%>
    </div>
<% } -%>
<% if (hasContact) { -%>
    <footer class="about-contact">
      <h2><%= t.aboutContactLabel %></h2>
      <div class="about-contact-cols">
<% if (contact.items.length) { -%>
        <ul class="about-contact-lines"<% if (contact.lang !== lang) { %> lang="<%= contact.lang %>"<% } %>>
<% for (const line of contact.items) { -%>
          <li><%= line %></li>
<% } -%>
        </ul>
<% } -%>
<% if (hasSocial) { -%>
        <ul class="social-list">
<% for (const [key, label] of social) { -%>
<% if (settings[key]) { -%>
          <li><a href="<%= settings[key] %>"><%= label %></a></li>
<% } -%>
<% } -%>
<% if (settings.email) { -%>
          <li><a href="mailto:<%= settings.email %>"><%= settings.email %></a></li>
<% } -%>
        </ul>
<% } -%>
      </div>
    </footer>
<% } -%>
  </article>
</main>
<%- include('partials/footer') %>
