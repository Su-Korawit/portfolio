<%
const val = (key, lang) => settings[key + ':' + (lang || '*')] || '';
-%>
<%- include('head', { title: 'ตั้งค่า', section: 'settings' }) %>
<main id="main">
  <div class="page-head">
    <h1>ตั้งค่า</h1>
  </div>
<% if (saved) { -%>
  <p class="form-saved" role="status">บันทึกแล้ว</p>
<% } -%>
  <form class="admin-form" method="post" action="/admin/settings">
    <label>ชื่อเว็บ
      <input name="site_name" value="<%= val('site_name') %>">
    </label>
    <div class="field-pair">
      <label>Tagline ภาษาไทย
        <input name="th[tagline]" value="<%= val('tagline', 'th') %>">
      </label>
      <label>Tagline ภาษาอังกฤษ
        <input name="en[tagline]" value="<%= val('tagline', 'en') %>" lang="en">
      </label>
    </div>
    <div class="field-pair">
      <label>About ภาษาไทย (markdown)
        <textarea name="th[about_body]" rows="10" class="editor-body"><%= val('about_body', 'th') %></textarea>
      </label>
      <label>About ภาษาอังกฤษ (markdown)
        <textarea name="en[about_body]" rows="10" class="editor-body" lang="en"><%= val('about_body', 'en') %></textarea>
      </label>
    </div>
    <div class="field-pair">
      <label>รูปโค้งของคุณในหน้า About (บรรทัดละ 1 รูป)
        <textarea name="about_image" rows="4" class="editor-body" placeholder="/uploads/" spellcheck="false"><%= val('about_image') %></textarea>
      </label>
      <label>อัปโหลดรูปโค้ง (เลือกได้หลายไฟล์)
        <input type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple data-upload-target="about_image" data-upload-mode="lines">
        <span class="field-hint">JPEG, PNG, GIF หรือ WebP ไม่เกิน 5 MB ต่อไฟล์ แล้ว URL จะถูกต่อท้ายช่องด้านซ้ายบรรทัดละรูป แนะนำรูปแนวตั้ง ใส่ได้สูงสุด 8 รูป ถ้าใส่มากกว่า 1 รูป หน้าเว็บจะเล่นเป็นสไลด์</span>
      </label>
    </div>
    <div class="field-pair">
      <label>คำอธิบายรูปโค้ง (alt) ภาษาไทย
        <input name="th[about_image_alt]" value="<%= val('about_image_alt', 'th') %>">
      </label>
      <label>คำอธิบายรูปโค้ง (alt) ภาษาอังกฤษ
        <input name="en[about_image_alt]" value="<%= val('about_image_alt', 'en') %>" lang="en">
      </label>
    </div>
    <div class="field-pair">
      <label>ชื่อที่แสดงตัวใหญ่ ภาษาไทย
        <input name="th[about_name]" value="<%= val('about_name', 'th') %>">
      </label>
      <label>ชื่อที่แสดงตัวใหญ่ ภาษาอังกฤษ
        <input name="en[about_name]" value="<%= val('about_name', 'en') %>" lang="en">
      </label>
    </div>
    <div class="field-pair">
      <label>ข้อมูลในกรอบ ภาษาไทย (บรรทัดละข้อ)
        <textarea name="th[about_facts]" rows="4" class="editor-body"><%= val('about_facts', 'th') %></textarea>
      </label>
      <label>ข้อมูลในกรอบ ภาษาอังกฤษ (บรรทัดละข้อ)
        <textarea name="en[about_facts]" rows="4" class="editor-body" lang="en"><%= val('about_facts', 'en') %></textarea>
      </label>
    </div>
    <label>สีที่ชอบ
      <input name="about_colors" value="<%= val('about_colors') %>" placeholder="#EDE7F6, #D1C4E9, #B39DDB, #9575CD" spellcheck="false">
    </label>
    <p class="field-hint">ใส่เป็นรหัสสี hex คั่นด้วยจุลภาค สูงสุด 8 สี ค่าที่ไม่ใช่ hex จะถูกข้าม</p>
    <div class="field-pair">
      <label>คำคม ภาษาไทย
        <input name="th[about_quote]" value="<%= val('about_quote', 'th') %>">
      </label>
      <label>คำคม ภาษาอังกฤษ
        <input name="en[about_quote]" value="<%= val('about_quote', 'en') %>" lang="en">
      </label>
    </div>
    <div class="field-pair">
      <label>ที่มาของคำคม ภาษาไทย
        <input name="th[about_quote_source]" value="<%= val('about_quote_source', 'th') %>">
      </label>
      <label>ที่มาของคำคม ภาษาอังกฤษ
        <input name="en[about_quote_source]" value="<%= val('about_quote_source', 'en') %>" lang="en">
      </label>
    </div>
    <label>ลิงก์ YouTube (บล็อก "รู้จักฉันมากขึ้น")
      <input name="about_video" value="<%= val('about_video') %>" placeholder="https://www.youtube.com/watch?v=..." spellcheck="false">
    </label>
    <p class="field-hint">วางลิงก์แบบไหนก็ได้ (youtube.com/watch, youtu.be, shorts) ถ้าอ่านรหัสวิดีโอไม่ได้ ระบบจะถือว่าว่างและไม่แสดงบล็อกนี้</p>
    <div class="field-pair">
      <label>ที่อยู่ติดต่อ ภาษาไทย (บรรทัดละข้อ)
        <textarea name="th[about_contact]" rows="3" class="editor-body"><%= val('about_contact', 'th') %></textarea>
      </label>
      <label>ที่อยู่ติดต่อ ภาษาอังกฤษ (บรรทัดละข้อ)
        <textarea name="en[about_contact]" rows="3" class="editor-body" lang="en"><%= val('about_contact', 'en') %></textarea>
      </label>
    </div>
    <p class="field-hint">อีเมลกับลิงก์ social ด้านล่างจะขึ้นในบล็อกติดต่อของหน้า About ให้เอง</p>
    <div class="field-pair">
      <label>Privacy ภาษาไทย (markdown)
        <textarea name="th[privacy_body]" rows="8" class="editor-body"><%= val('privacy_body', 'th') %></textarea>
      </label>
      <label>Privacy ภาษาอังกฤษ (markdown)
        <textarea name="en[privacy_body]" rows="8" class="editor-body" lang="en"><%= val('privacy_body', 'en') %></textarea>
      </label>
    </div>
    <div class="field-pair">
      <label>GitHub URL
        <input type="url" name="github_url" value="<%= val('github_url') %>">
      </label>
      <label>LinkedIn URL
        <input type="url" name="linkedin_url" value="<%= val('linkedin_url') %>">
      </label>
    </div>
    <div class="field-pair">
      <label>X URL
        <input type="url" name="x_url" value="<%= val('x_url') %>">
      </label>
      <label>Instagram URL
        <input type="url" name="instagram_url" value="<%= val('instagram_url') %>">
      </label>
    </div>
    <label>อีเมล
      <input type="email" name="email" value="<%= val('email') %>">
    </label>
    <p class="field-hint">ช่องไหนเว้นว่าง ระบบจะลบค่านั้นออกตอนบันทึก</p>
    <button type="submit">บันทึก</button>
  </form>
  <h2>ออกจากระบบทุกเครื่อง</h2>
  <p class="field-hint">ใช้เมื่อสงสัยว่ามีคนอื่นได้ cookie ของผู้ดูแลไป ปุ่มนี้ทำให้ cookie เดิมทุกใบใช้ไม่ได้ทันที รวมถึงเครื่องนี้ ต้อง เข้าสู่ระบบ ใหม่</p>
  <form method="post" action="/admin/sessions/revoke">
    <button type="submit">ออกจากระบบทุกเครื่อง</button>
  </form>
</main>
<script src="/js/admin.js?v=<%= v %>" defer></script>
<%- include('foot') %>
