<%
const pageTitle = id ? 'แก้ไขบทความ' : 'บทความใหม่';
const langNames = { th: 'ไทย', en: 'English' };
const errorPrefix = { th: 'ฉบับไทย: ', en: 'ฉบับอังกฤษ: ' };
const statusOptions = [['none', 'ไม่มีฉบับนี้'], ['draft', 'แบบร่าง'], ['published', 'เผยแพร่']];
const errorList = Object.entries(errors).map(([key, message]) => (errorPrefix[key.split('.')[0]] || '') + message);
const placeholders = { th: { title: 'หัวข้อบทความ', body: 'เริ่มเขียนที่นี่' }, en: { title: 'Title', body: 'Tell your story' } };
-%>
<%- include('head', { title: pageTitle, section: 'posts' }) %>
<main id="main" class="editor">
  <form class="admin-form" method="post" action="<%= id ? '/admin/posts/' + id : '/admin/posts' %>">
    <div class="page-head">
      <h1><%= pageTitle %></h1>
      <button type="submit">บันทึก</button>
    </div>
<% if (saved) { -%>
    <p class="form-saved" role="status">บันทึกแล้ว</p>
<% } -%>
<% if (errorList.length) { -%>
    <div class="form-error" role="alert">
      <p>ยังไม่ได้บันทึก กรุณาแก้ตามรายการนี้</p>
      <ul>
<% for (const message of errorList) { -%>
        <li><%= message %></li>
<% } -%>
      </ul>
    </div>
<% } -%>
    <section class="editor-shared">
      <div class="field-row">
        <label>ซีรีส์
          <input name="series" value="<%= values.series %>" list="series-names" placeholder="ไม่อยู่ในซีรีส์" autocomplete="off">
          <datalist id="series-names">
<% for (const name of seriesNames) { -%>
            <option value="<%= name %>">
<% } -%>
          </datalist>
        </label>
        <label>ตอนที่
          <input name="series_part" value="<%= values.series_part %>" inputmode="numeric" placeholder="ตอนถัดไป">
<% if (errors.series_part) { -%>
          <span class="field-error" lang="th"><%= errors.series_part %></span>
<% } -%>
        </label>
        <label>ภาพหน้าปก
          <input type="hidden" name="cover_image" value="<%= values.cover_image %>">
<% if (values.cover_image) { -%>
          <span class="field-hint">มีภาพปกแล้ว เลือกไฟล์ใหม่เพื่อเปลี่ยน</span>
<% } -%>
          <input type="file" accept="image/jpeg,image/png,image/gif,image/webp" data-upload-target="cover_image">
        </label>
      </div>
<% if (tags.length) { -%>
      <fieldset class="tag-options">
        <legend>แท็ก</legend>
<% for (const tag of tags) { -%>
        <label><input type="checkbox" name="tags" value="<%= tag.id %>"<% if (values.tags.includes(tag.id)) { %> checked<% } %>> <%= tag.slug %></label>
<% } -%>
      </fieldset>
<% } -%>
    </section>
<% for (const lang of ['th', 'en']) {
     const tr = values[lang];
-%>
    <details class="translation" lang="<%= lang %>"<% if (lang === 'th' || tr.status !== 'none') { %> open<% } %>>
      <summary><%= langNames[lang] %></summary>
      <div class="translation-fields">
        <%# not shown, but kept: a save would otherwise blank them, and a changed slug breaks the post's link %>
<% for (const field of ['slug', 'excerpt', 'cover_image_alt', 'seo_title', 'seo_description']) { -%>
        <input type="hidden" name="<%= lang %>[<%= field %>]" value="<%= tr[field] %>">
<% } -%>
        <label class="write-field"><span class="sr-only" lang="th">หัวข้อ</span>
          <input class="editor-title" name="<%= lang %>[title]" value="<%= tr.title %>" placeholder="<%= placeholders[lang].title %>">
<% if (errors[lang + '.title']) { -%>
          <span class="field-error" lang="th"><%= errors[lang + '.title'] %></span>
<% } -%>
        </label>
        <label class="write-field"><span class="sr-only" lang="th">เนื้อหา (markdown)</span>
          <textarea class="editor-body" name="<%= lang %>[body_markdown]" rows="18" placeholder="<%= placeholders[lang].body %>">
<%= tr.body_markdown %></textarea>
        </label>
        <div class="translation-actions">
          <label class="inline-field"><span lang="th">สถานะ</span>
            <select name="<%= lang %>[status]" lang="th"<% if (stored[lang]) { %> data-prev="<%= tr.status %>" onchange="if (this.value === 'none') { if (!confirm('ลบฉบับภาษานี้เมื่อบันทึก?')) this.value = this.dataset.prev } this.dataset.prev = this.value"<% } %>>
<% for (const [value, label] of statusOptions) { -%>
              <option value="<%= value %>"<% if (tr.status === value) { %> selected<% } %>><%= label %></option>
<% } -%>
            </select>
          </label>
          <label class="inline-field"><span lang="th">แทรกรูป</span>
            <input type="file" accept="image/jpeg,image/png,image/gif,image/webp" data-upload-target="<%= lang %>[body_markdown]">
          </label>
          <button type="submit" class="button-quiet" formaction="/admin/posts/preview/<%= lang %>" formtarget="_blank" lang="th">ดูตัวอย่าง</button>
        </div>
      </div>
    </details>
<% } -%>
  </form>
<% if (id) { -%>
  <form class="editor-delete" method="post" action="/admin/posts/<%= id %>/delete" onsubmit="return confirm('ลบบทความนี้?')">
    <button type="submit">ลบบทความ</button>
  </form>
<% } -%>
</main>
<script src="/js/admin.js?v=<%= v %>" defer></script>
<%- include('foot') %>
